{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchOptions": {
      "watchFile": "dynamicPolling",
      "watchDirectory": "dynamicPolling",
      "fallbackPolling": "dynamicPriority"
    }
  }
}
